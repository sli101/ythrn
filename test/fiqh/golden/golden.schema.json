{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ythrn/golden.schema.json",
  "title": "حالة اختبار ذهبية — مستقلة عن المحرك",
  "type": "object",
  "required": ["id", "group", "title", "source", "subject", "profile", "timeline", "expected"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^G-(TXT|HAB|TIME|UNK|AUDIT|NIF|IST|ELG|DUT)-[0-9]{2,3}$" },
    "group": { "enum": ["text", "habit", "time", "unknown", "audit", "nifas", "istihadha", "eligibility", "duties"] },
    "title": { "type": "string" },
    "source": { "type": "string", "description": "الإحالة كما في الاستخراج (ج م٥٥٩، س ٣٧٠٠، م٢٢١، SPEC §٤)" },
    "rules": { "type": "array", "items": { "type": "string" }, "description": "معرّفات القواعد المتوقَّع ظهورها في الأثر" },
    "subject": { "enum": ["HAYD", "NIFAS", "SIQT", "ISTIHADHA"] },
    "profile": { "$ref": "#/$defs/profile" },
    "clock": {
      "type": "object",
      "description": "مواقيت ثابتة للسيناريو؛ الافتراضي فجر 04:30 ومغرب 18:30 لكل يوم",
      "additionalProperties": false,
      "properties": { "fajr": { "$ref": "#/$defs/hhmm" }, "maghrib": { "$ref": "#/$defs/hhmm" } }
    },
    "timeline": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/timelineItem" } },
    "answers": { "$ref": "#/$defs/answers" },
    "expected": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expectation" } },
    "notes": { "type": "string" },
    "pendingOwner": { "type": "string", "description": "الحالة معلَّقة على قرار المالك (تعارض نصوص أو افتراض)؛ لا تُشغَّل على المحرك حتى يُحسم" }
  },
  "$defs": {
    "hhmm": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "dayRange": { "type": "string", "pattern": "^[0-9]{1,3}(-[0-9]{1,3})?$", "description": "يوم أو مدى أيام: \"5\" أو \"5-9\". الأيام تُعدّ من ١ (يوم السيناريو الأول)؛ اليوم من الفجر إلى المغرب والليلة التي تليه تحمل رقمه" },
    "instant": { "type": "string", "pattern": "^D[0-9]{1,3} (fajr|maghrib|noon|([01][0-9]|2[0-3]):[0-5][0-9])$", "description": "لحظة: \"D4 11:30\" أو \"D1 fajr\" أو \"D11 maghrib\"" },
    "tri": { "enum": [true, false, "dont_understand", "dont_remember"] },
    "womanType": { "enum": ["ANY", "VW", "V", "W", "MUB", "MUD", "NAS_T", "NAS_C", "NAS_B"] },
    "profile": {
      "type": "object",
      "required": ["womanType"],
      "additionalProperties": false,
      "properties": {
        "womanType": { "$ref": "#/$defs/womanType" },
        "habit": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "anchor": { "enum": ["start", "end"] },
            "start": { "type": "integer", "description": "يوم بدء العادة بأرقام أيام السيناريو" },
            "end": { "type": "integer", "description": "يوم انتهاء العادة (لذات الوقتية بآخرها)" },
            "count": { "type": "integer", "minimum": 3, "maximum": 10 },
            "deficient": { "type": "object", "additionalProperties": false, "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } } },
            "memory": {
              "type": "object",
              "description": "ذاكرة الناسية الجزئية",
              "additionalProperties": false,
              "properties": {
                "countMin": { "type": "integer" }, "countMax": { "type": "integer" },
                "timeWindow": { "$ref": "#/$defs/dayRange" },
                "knownDays": { "type": "array", "items": { "type": "integer" } }
              }
            }
          }
        },
        "history": {
          "type": "array",
          "description": "حيضات سابقة محكوم بها لاختبار آلة العادة (بترتيب الزمن)",
          "items": {
            "type": "object", "required": ["start", "bloodDays"], "additionalProperties": false,
            "properties": { "start": { "type": "integer", "description": "يوم البدء بأرقام سيناريو مطلقة (قد تكون سالبة لما قبل اليوم ١)" }, "bloodDays": { "type": "number" }, "end": { "type": "integer" } }
          }
        },
        "declared": { "type": ["object", "null"], "description": "تصريح ابتدائي بنوع العادة عند أول استخدام", "additionalProperties": false,
          "properties": { "womanType": { "$ref": "#/$defs/womanType" }, "count": { "type": "integer" }, "start": { "type": "integer" } } },
        "kinCount": { "type": ["integer", "null"] },
        "chosenCount": { "type": ["integer", "null"] },
        "lastBloodEnd": { "type": ["integer", "null"], "description": "يوم انتهاء آخر حيض/نفاس بأرقام سيناريو (سالب لما قبل اليوم ١)" },
        "ageHijri": { "type": ["number", "null"] },
        "ageDoubt": { "enum": ["nine", "sixty"] },
        "isQurashi": { "$ref": "#/$defs/tri" },
        "pregnant": { "$ref": "#/$defs/tri" },
        "hysterectomy": { "$ref": "#/$defs/tri" },
        "wasMustahadhaBefore": { "$ref": "#/$defs/tri" }
      }
    },
    "timelineItem": {
      "oneOf": [
        {
          "type": "object",
          "description": "مقطع أيام",
          "required": ["days", "blood"],
          "additionalProperties": false,
          "properties": {
            "days": { "$ref": "#/$defs/dayRange" },
            "blood": { "enum": [true, false, "spots"], "description": "true دم مستمر؛ false نقاء؛ spots لطخات متقطعة" },
            "props": { "enum": ["wajid", "faqid", null], "description": "واجد لصفات الحيض / فاقد لها" },
            "nights": { "type": "boolean", "default": true, "description": "هل الدم مستمر في الليالي المتوسطة" },
            "kursuf": { "enum": ["stained", "clean", "none"], "description": "نتيجة القطنة في هذا المقطع إن كان نقاءً ظاهرًا" }
          }
        },
        {
          "type": "object",
          "description": "حدث بلحظة",
          "required": ["at", "event"],
          "additionalProperties": false,
          "properties": {
            "at": { "$ref": "#/$defs/instant" },
            "event": { "enum": ["bloodStart", "bloodStop", "birth", "miscarriage", "kursufClean", "kursufStained", "ghusl", "fullStop", "istihadhaTest", "virginityTest", "sourceNote"] },
            "source": { "enum": ["wound", "virginity", "labor", "doubtWoundOrHayd", "doubtVirginityOrHayd"] },
            "result": { "enum": ["ringed", "soaked"] },
            "level": { "enum": ["qalila", "mutawassita", "kathira"] },
            "flow": { "enum": ["continuous", "intermittent"] },
            "props": { "enum": ["wajid", "faqid", null] },
            "minutes": { "type": "integer", "description": "لـ fullStop: مدة الانقطاع التام بالدقائق" },
            "stage": { "enum": ["nutfa", "alaqa", "mudgha", "formed", "unknown"] },
            "ensouled": { "type": "boolean" },
            "twins": { "type": "boolean" }
          }
        }
      ]
    },
    "answers": {
      "type": "object",
      "description": "أجوبة المستخدمة على أسئلة المحرك (Tri)",
      "additionalProperties": false,
      "properties": {
        "willLastThreeDays": { "$ref": "#/$defs/tri" },
        "willReturnBeforeTen": { "$ref": "#/$defs/tri" },
        "willExceedTen": { "$ref": "#/$defs/tri" },
        "innerContinuity": { "$ref": "#/$defs/tri" },
        "isEarlyHabit": { "$ref": "#/$defs/tri" },
        "isBlood": { "$ref": "#/$defs/tri" },
        "kinConditionsMet": { "$ref": "#/$defs/tri" },
        "ramadanTomorrow": { "$ref": "#/$defs/tri" }
      }
    },
    "state": {
      "enum": ["HAYD", "NIFAS", "IST", "IST_Q", "IST_M", "IST_K", "IST_U", "TAHIR", "JAM3", "JAM3_M", "JAM3_N", "JAM3_NM", "GHAYR", "PENDING", "NOT_HAYD"],
      "description": "IST = استحاضة بأي قسم؛ NOT_HAYD = النص يقول «ليس بحيض» بلا تعيين. haydCount = عدد أيام الحيض الناتج عند التجاوز (H7)، وhabitCount = عدد العادة في آلة الحالة (H4)"
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object", "required": ["days", "state"], "additionalProperties": false,
          "properties": {
            "days": { "$ref": "#/$defs/dayRange" },
            "state": { "$ref": "#/$defs/state" },
            "classification": { "enum": ["fatwa", "ihtiyat_wujubi", "ishkal"] },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object", "required": ["assert"], "additionalProperties": false,
          "description": "تأكيد غير يومي",
          "properties": {
            "assert": { "enum": ["habitType", "habitCount", "habitStart", "haydCount", "alertGhuslMayyit", "alertGhuslHayd", "qadaFasts", "minTuhrEndsAt", "threeDaysCompleteAt", "tenDaysEndAt", "overflow", "noOverflow", "qadaPrayers", "alertGhuslBeforeFajr", "nextQuestion", "pendingInput", "questionPath"] },
            "value": {},
            "at": { "$ref": "#/$defs/instant" },
            "then": { "type": ["string", "null"], "description": "لـ questionPath: معرّف السؤال التالي بعد المسار أو null" },
            "state": { "$ref": "#/$defs/state", "description": "لـ questionPath: حالة اليوم بعد تطبيق الأجوبة" },
            "stateAt": { "$ref": "#/$defs/instant", "description": "لحظة فحص state؛ الافتراضي ضحى آخر يوم" },
            "note": { "type": "string" }
          }
        }
      ]
    }
  }
}
